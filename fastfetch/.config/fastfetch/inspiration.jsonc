// Ulster University x Fedora
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/uu_fedora_logo.png",
    "type": "auto",
    "width": 20,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 3,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#39} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#39} hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "│ {#39} os age  {#keys}│",
      "keyColor": "blue",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$((($(date +%s) - $(stat -c %W /)) / 86400))\"",
    },
    {
      "key": "│ {#39} uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#39}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#39} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#39} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#39} desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#39} term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#39} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#39} cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#39} disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#39} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#39} localip {#keys}│",
      "type": "localip",
      "showIpv4": true,
      "showIpv6": false,
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
